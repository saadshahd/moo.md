{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"levels": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"review": {
						"type": "string",
						"enum": [
							"none",
							"agent",
							"owner"
						]
					},
					"release": {
						"type": "string",
						"enum": [
							"at-once",
							"after-proof"
						]
					},
					"onBreak": {
						"type": "string",
						"enum": [
							"follow-up",
							"block"
						]
					}
				},
				"required": [
					"name",
					"review",
					"release",
					"onBreak"
				],
				"additionalProperties": false
			}
		},
		"paths": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"glob": {
						"type": "string",
						"minLength": 1
					},
					"level": {
						"type": "string",
						"minLength": 1
					},
					"proofs": {
						"type": "object",
						"propertyNames": {
							"type": "string",
							"minLength": 1
						},
						"additionalProperties": {
							"type": "string",
							"minLength": 1
						}
					},
					"limit": {
						"type": "object",
						"properties": {
							"fixes": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"of": {
								"type": "integer",
								"exclusiveMinimum": 0,
								"maximum": 9007199254740991
							}
						},
						"required": [
							"fixes",
							"of"
						],
						"additionalProperties": false
					}
				},
				"required": [
					"glob",
					"level"
				],
				"additionalProperties": false
			}
		},
		"roles": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"minLength": 1
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"file": {
						"type": "string",
						"minLength": 1
					},
					"purpose": {
						"type": "string",
						"enum": [
							"plan",
							"build",
							"fix",
							"review"
						]
					},
					"skills": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"required": [
					"file",
					"purpose",
					"skills"
				],
				"additionalProperties": false
			}
		},
		"events": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"minLength": 1
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"source": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"source"
				],
				"additionalProperties": false
			}
		},
		"kinds": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"safety": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {}
		},
		"decisionModel": {
			"type": "string",
			"minLength": 1
		},
		"dailyQuestionCap": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"integrations": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"minLength": 1
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			}
		},
		"ciToken": {
			"type": "object",
			"properties": {
				"setUp": {
					"type": "string",
					"format": "date",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
				}
			},
			"required": [
				"setUp"
			],
			"additionalProperties": false
		},
		"runBranchPrefix": {
			"default": "hum/run/",
			"type": "string",
			"format": "ends_with",
			"pattern": ".*\\/$",
			"description": "Each run builds on the branch this prefix and its item id make."
		},
		"claimPrefix": {
			"default": "hum/claim/",
			"type": "string",
			"format": "ends_with",
			"pattern": ".*\\/$",
			"description": "A claim is the first push of the branch this prefix and its item id make."
		},
		"readyLabel": {
			"default": "hum:ready",
			"type": "string",
			"minLength": 1,
			"description": "The label that marks an issue ready for hum."
		},
		"mergeMethod": {
			"default": "squash",
			"type": "string",
			"enum": [
				"merge",
				"squash",
				"rebase"
			],
			"description": "How a released pull request merges."
		},
		"models": {
			"default": {
				"light": "claude-haiku-5-5",
				"standard": "claude-sonnet-5-5",
				"top": "claude-opus-5-5"
			},
			"type": "object",
			"propertyNames": {
				"type": "string",
				"enum": [
					"light",
					"standard",
					"top"
				]
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			},
			"required": [
				"light",
				"standard",
				"top"
			],
			"description": "The model id each tier of a kind's table runs on."
		},
		"runners": {
			"default": 3,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "The most runs that go at once."
		},
		"tickIntervalSeconds": {
			"default": 30,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "The time between worker ticks; each tick writes the heartbeat and renews the claims in flight."
		},
		"drainTimeoutSeconds": {
			"default": 300,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "How long a worker that has seen an update lets its runs finish before it stops them."
		},
		"claimExpirySeconds": {
			"default": 900,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "How long a claim lasts unless its holder renews it."
		},
		"latestVersionCacheSeconds": {
			"default": 21600,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "How long the newest published engine version is kept before it is read again."
		},
		"maxFixRuns": {
			"default": 3,
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991,
			"description": "Fix runs an item gets after failed checks before it ends stuck."
		},
		"serviceLabel": {
			"default": "md.moo.hum",
			"type": "string",
			"pattern": "^[A-Za-z0-9._-]+$",
			"description": "The service unit's label, and the name its file takes."
		},
		"maxCrashes": {
			"default": 5,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Worker crashes within crashWindowSeconds that stop the service's restarts."
		},
		"crashWindowSeconds": {
			"default": 600,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "The window in which maxCrashes crashes stop the service's restarts."
		},
		"workerDownTicks": {
			"default": 3,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Ticks without a heartbeat before the worker-down card shows."
		},
		"tokenWarnDays": {
			"default": 30,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Days before the CI token's year ends that the expiry card shows."
		},
		"ciSchedule": {
			"default": "*/15 * * * *",
			"type": "string",
			"description": "The cron schedule of the scheduled CI workflow."
		},
		"ciTickCacheSeconds": {
			"default": 300,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "How long the scheduled workflow's last tick is kept before the remote is read again."
		},
		"commitIdentity": {
			"default": {
				"name": "hum",
				"email": "hum@moo.md"
			},
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"email": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"name",
				"email"
			],
			"additionalProperties": false,
			"description": "The author and committer of every commit hum makes itself."
		},
		"itemsDir": {
			"default": ".hum/work",
			"type": "string",
			"minLength": 1,
			"description": "The folder of the repo that holds the markdown items."
		},
		"providerTimeoutSeconds": {
			"default": 30,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "How long a failing provider call is retried before one card shows."
		},
		"providerBackoff": {
			"default": {
				"firstSeconds": 0.5,
				"maxSeconds": 30
			},
			"type": "object",
			"properties": {
				"firstSeconds": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"maxSeconds": {
					"type": "number",
					"exclusiveMinimum": 0
				}
			},
			"required": [
				"firstSeconds",
				"maxSeconds"
			],
			"additionalProperties": false,
			"description": "The pause before a provider call's first retry, doubled each retry up to the longest pause."
		},
		"mergedShown": {
			"default": 50,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Merged changes the status file lists."
		},
		"statusReadTimeoutSeconds": {
			"default": 10,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "How long a read for the status file, such as the newest published version, may take before it is left out."
		},
		"mergeTries": {
			"default": 3,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Tries to merge a change when the base branch moves under it."
		},
		"writeRaceRetries": {
			"default": 7,
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991,
			"description": "Retries of a markdown write that another writer's push beat."
		},
		"itemReadsAtOnce": {
			"default": 8,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Item files the markdown source reads at once; each read is a git process."
		},
		"restartBackoff": {
			"default": {
				"firstSeconds": 1,
				"maxSeconds": 60
			},
			"type": "object",
			"properties": {
				"firstSeconds": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"maxSeconds": {
					"type": "number",
					"exclusiveMinimum": 0
				}
			},
			"required": [
				"firstSeconds",
				"maxSeconds"
			],
			"additionalProperties": false,
			"description": "The pause before the service's first restart of a crashed worker, doubled each crash up to the longest pause."
		},
		"restartDelaySeconds": {
			"default": 10,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Seconds the service manager waits before it starts a failed start script again."
		},
		"ciWakeTimeoutMinutes": {
			"default": 60,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Minutes a CI wake may run before GitHub stops it."
		},
		"strictPaths": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Globs of data and secrets: a change touching one takes the strictest level."
		},
		"launches": {
			"default": [],
			"type": "array",
			"items": {
				"anyOf": [
					{
						"type": "object",
						"properties": {
							"glob": {
								"type": "string",
								"minLength": 1
							},
							"level": {
								"type": "string",
								"minLength": 1
							},
							"from": {
								"type": "string",
								"format": "date",
								"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
							},
							"until": {
								"type": "string",
								"format": "date",
								"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
							}
						},
						"required": [
							"glob",
							"level",
							"from",
							"until"
						],
						"additionalProperties": false
					},
					{
						"type": "object",
						"properties": {
							"glob": {
								"type": "string",
								"minLength": 1
							},
							"level": {
								"type": "string",
								"minLength": 1
							},
							"base": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"glob",
							"level",
							"base"
						],
						"additionalProperties": false
					}
				]
			},
			"description": "Raises a path to a level for a launch: between two dates, from 'from' up to 'until', or while the base branch matches 'base'."
		},
		"sizeRange": {
			"default": {
				"changes": 50,
				"fewest": 20,
				"middle": 0.8
			},
			"type": "object",
			"properties": {
				"changes": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"fewest": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"middle": {
					"type": "number",
					"exclusiveMinimum": 0,
					"exclusiveMaximum": 1
				}
			},
			"required": [
				"changes",
				"fewest",
				"middle"
			],
			"additionalProperties": false,
			"description": "A path's usual size: the middle share of the lines its last 'changes' merged changes touched. A change above it goes one level up; a path with fewer than 'fewest' changes has no range."
		},
		"loosenedCheck": {
			"default": {
				"added": [
					"\\.(skip|skipIf|todo)\\(",
					"\\bx(it|test|describe)\\(",
					"(eslint|oxlint|biome)[- ](disable|ignore)",
					"@ts-(ignore|expect-error|nocheck)"
				],
				"removed": [
					"^\\s*(test|it|describe)(\\.\\w+)?\\(",
					"^\\s*\"[@\\w/-]+\"\\s*:\\s*\\[?\"(error|warn)\""
				]
			},
			"type": "object",
			"properties": {
				"added": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"removed": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": [
				"added",
				"removed"
			],
			"additionalProperties": false,
			"description": "A change whose added or removed lines match one of these loosens a check and goes one level up; empty lists turn the rule off."
		},
		"changeLabels": {
			"default": {
				"fixWindow": 10,
				"fixSubject": "^fix(\\(.+\\))?!?:",
				"revertSubject": "^Revert \"",
				"revertTrailer": "This reverts commit ([0-9a-f]{7,40})"
			},
			"type": "object",
			"properties": {
				"fixWindow": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"fixSubject": {
					"type": "string",
					"minLength": 1
				},
				"revertSubject": {
					"type": "string",
					"minLength": 1
				},
				"revertTrailer": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"fixWindow",
				"fixSubject",
				"revertSubject",
				"revertTrailer"
			],
			"additionalProperties": false,
			"description": "How hum labels a merged change from git: reverted by a commit whose trailer names it or whose subject reverts its subject; fixed by a fix commit within the next 'fixWindow' merged changes on its files that names it or changes its lines."
		},
		"historyDepth": {
			"default": 1000,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991,
			"description": "Commits of the base branch hum reads for size ranges and fix counts."
		},
		"lockfiles": {
			"default": [
				"bun.lock",
				"bun.lockb",
				"package-lock.json",
				"yarn.lock",
				"pnpm-lock.yaml"
			],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Lockfiles where a changed line naming the engine package changes hum itself."
		},
		"hookPaths": {
			"default": [
				".husky/**",
				".githooks/**",
				"lefthook.yml",
				".pre-commit-config.yaml"
			],
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"description": "Globs of tracked git hooks; a change to one changes hum itself."
		}
	},
	"required": [
		"schemaVersion",
		"levels",
		"paths",
		"roles",
		"events",
		"kinds"
	],
	"additionalProperties": false
}
