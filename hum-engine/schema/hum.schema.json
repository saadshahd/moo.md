{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"levels": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"paths": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"glob": {
						"type": "string",
						"minLength": 1
					},
					"level": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"glob",
					"level"
				],
				"additionalProperties": false
			}
		},
		"roles": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"minLength": 1
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"file": {
						"type": "string",
						"minLength": 1
					},
					"purpose": {
						"type": "string",
						"enum": [
							"plan",
							"build",
							"fix",
							"review"
						]
					},
					"skills": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"required": [
					"file",
					"purpose",
					"skills"
				],
				"additionalProperties": false
			}
		},
		"events": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"minLength": 1
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"source": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"source"
				],
				"additionalProperties": false
			}
		},
		"kinds": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"safety": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {}
		},
		"decisionModel": {
			"type": "string",
			"minLength": 1
		},
		"dailyQuestionCap": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"integrations": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"minLength": 1
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			}
		},
		"ciToken": {
			"type": "object",
			"properties": {
				"setUp": {
					"type": "string",
					"format": "date",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
				}
			},
			"required": [
				"setUp"
			],
			"additionalProperties": false
		},
		"runBranchPrefix": {
			"default": "hum/run/",
			"type": "string",
			"format": "ends_with",
			"pattern": ".*\\/$"
		},
		"claimPrefix": {
			"default": "hum/claim/",
			"type": "string",
			"format": "ends_with",
			"pattern": ".*\\/$"
		},
		"readyLabel": {
			"default": "hum:ready",
			"type": "string",
			"minLength": 1
		},
		"mergeMethod": {
			"default": "squash",
			"type": "string",
			"enum": [
				"merge",
				"squash",
				"rebase"
			]
		},
		"models": {
			"default": {
				"light": "claude-haiku-5-5",
				"standard": "claude-sonnet-5-5",
				"top": "claude-opus-5-5"
			},
			"type": "object",
			"propertyNames": {
				"type": "string",
				"enum": [
					"light",
					"standard",
					"top"
				]
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			},
			"required": [
				"light",
				"standard",
				"top"
			]
		},
		"runners": {
			"default": 3,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"tickIntervalSeconds": {
			"default": 30,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"drainTimeoutSeconds": {
			"default": 300,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"claimExpirySeconds": {
			"default": 900,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"latestVersionCacheSeconds": {
			"default": 21600,
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"maxFixRuns": {
			"default": 3,
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		}
	},
	"required": [
		"schemaVersion",
		"levels",
		"paths",
		"roles",
		"events",
		"kinds"
	],
	"additionalProperties": false
}
