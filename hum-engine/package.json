{
  "name": "@moo.md/hum",
  "version": "0.1.0",
  "description": "The hum engine: work items become Claude Code agent runs, the repo's checks decide what they can, and only what nothing settles becomes a question to the owner.",
  "license": "MIT",
  "author": {
    "name": "Saad Shahd",
    "url": "https://saadshahd.github.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadshahd/moo.md.git",
    "directory": "hum-engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "hum": "src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./adapter-api": "./src/adapter-api.ts"
  },
  "files": [
    "src",
    "schema",
    "defaults",
    "templates"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "schema": "bun scripts/write-schema.ts",
    "lint": "oxlint src test",
    "test": "bun test test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@octokit/core": "7.0.8",
    "@octokit/graphql": "9.0.5",
    "@octokit/plugin-paginate-graphql": "6.0.0",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/request-error": "7.1.2",
    "@sindresorhus/slugify": "4.0.0",
    "@statelyai/agent": "2.0.0-alpha.37",
    "commander": "15.1.0",
    "hosted-git-info": "10.1.1",
    "is-git-ref-name-valid": "1.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "micromark-extension-frontmatter": "2.0.0",
    "p-limit": "7.3.3",
    "p-memoize": "9.0.0",
    "p-retry": "9.0.0",
    "safe-stable-stringify": "3.0.0",
    "tinyexec": "1.3.1",
    "xstate": "6.0.0-beta.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.3.14",
    "@types/hosted-git-info": "3.0.5",
    "@types/mdast": "4.0.4",
    "oxlint": "1.89.0",
    "typescript": "5.9.2"
  }
}
