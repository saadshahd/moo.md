		},
		{
			"purpose": "fix",
			"level": "critical",
			"tier": "top",
			"effort": "high"
		},
		{
			"purpose": "review",
			"tier": "standard",
			"effort": "medium"
		},
		{
			"purpose": "review",
			"level": "high",
			"tier": "top",
			"effort": "high"
		},
		{
			"purpose": "review",
			"level": "critical",
			"tier": "top",
			"effort": "high"
		}
	],
	"tokenCap": {
		"tokens": 500000,
		"overCap": "asking"
	},
	"machine": {
		"id": "fix",
		"version": "3",
		"initial": "reproducing",
		"states": {
			"reproducing": {
				"invoke": {
					"src": "repro",
					"onDone": {
						"target": "confirming"
					},
					"onError": {
						"target": "stuck"
					}
				},
				"on": {
					"token-cap": {
						"target": "asking-repro"
					}
				}
			},
			"confirming": {
				"invoke": {
					"src": "shows-bug",
					"onDone": {
						"target": "objecting"
					},
					"onError": {
						"target": "stuck"
					}
				},
				"on": {
					"token-cap": {
						"target": "asking-repro"
					},
					"window-passed": {
						"target": "building"
					}
				}
			},
			"objecting": {
				"on": {
					"answered": {
						"target": "reproducing"
					}
				},
				"after": {
					"86400000": {
						"target": "building"
					}
				},
				"meta": {
					"interaction": {
						"label": "Object to the repro, or let the fix go on",
						"textEvent": "answered"
					}
				}
			},
			"building": {
				"invoke": {
					"src": "build",
					"onDone": {
						"target": "checking"
					},
					"onError": {
						"target": "stuck"
					}
				},
				"on": {
					"token-cap": {
						"target": "asking"
					}
				}
			},
			"checking": {
				"invoke": {
					"src": "checks",
					"onDone": {
						"target": "proving"
					},
					"onError": {
						"target": "fixing"
					}
				}
			},
			"proving": {
				"invoke": {
					"src": "bug-gone",
					"onDone": {
						"target": "reviewing"
					},
					"onError": {
						"target": "fixing"
					}
				}
			},
			"fixing": {
				"invoke": {
					"src": "fix",
					"onDone": {
						"target": "checking"
					},
					"onError": {
						"target": "stuck"
					}
				},
				"on": {
					"token-cap": {
						"target": "asking"
					}
				}
			},
			"reviewing": {
				"invoke": {
					"src": "review",
					"onError": {
						"target": "stuck"
					}
				},
				"on": {
					"approve": {
						"target": "merging"
					},
					"request-changes": {
						"target": "fixing"
					},
					"needs-owner": {
						"target": "owner-review"
					}
				}
			},
			"owner-review": {
				"on": {
					"owner-approved": {
						"target": "merging"
					},
					"owner-rejected": {
						"target": "fixing"
					}
				},
				"meta": {
					"interaction": {
						"label": "Review the change",
						"choices": [
							{
								"label": "Approve",
								"event": {
									"type": "owner-approved"
								}
							}
						],
						"textEvent": "owner-rejected"
					}
				}
			},
			"merging": {
				"on": {
					"merged": {
						"target": "done"
					}
				}
			},
			"asking": {
				"on": {
					"answered": {
						"target": "building"
					}
				},
				"meta": {
					"interaction": {
						"label": "Answer the run's question",
						"textEvent": "answered"
					}
				}
			},
			"asking-repro": {
				"on": {
					"answered": {
						"target": "reproducing"
					}
				},
				"meta": {
					"interaction": {
						"label": "Answer the repro run's question",
						"textEvent": "answered"
					}
				}
			},
			"stuck": {
				"tags": [
					"stuck"
				]
			},
			"done": {
				"type": "final"
			}
		}
	}
}
