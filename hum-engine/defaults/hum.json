{
	"schemaVersion": 1,
	"levels": [
		"low",
		"medium",
		"high",
		"critical"
	],
	"paths": [],
	"roles": {
		"plan": {
			"file": "roles/plan.md",
			"purpose": "plan",
			"skills": [
				"hope:intent",
				"hope:shape"
			]
		},
		"build": {
			"file": "roles/build.md",
			"purpose": "build",
			"skills": []
		},
		"fix": {
			"file": "roles/fix.md",
			"purpose": "fix",
			"skills": []
		},
		"review": {
			"file": "roles/review.md",
			"purpose": "review",
			"skills": [
				"hope:judge"
			]
		}
	},
	"events": {
		"plan-ready": {
			"source": "plan"
		},
		"needs-split": {
			"source": "plan"
		},
		"plan-blocked": {
			"source": "plan"
		},
		"token-cap": {
			"source": "worker"
		},
		"approve": {
			"source": "review"
		},
		"request-changes": {
			"source": "review"
		},
		"needs-owner": {
			"source": "review"
		},
		"answered": {
			"source": "owner"
		},
		"owner-approved": {
			"source": "owner"
		},
		"owner-rejected": {
			"source": "owner"
		},
		"merged": {
			"source": "work-source"
		}
	},
	"kinds": [
		"feature",
		"fix",
		"docs",
		"hotfix",
		"check"
	],
	"runBranchPrefix": "hum/run/",
	"claimPrefix": "hum/claim/",
	"readyLabel": "hum:ready",
	"mergeMethod": "squash",
	"models": {
		"light": "claude-haiku-5-5",
		"standard": "claude-sonnet-5-5",
		"top": "claude-opus-5-5"
	},
	"runners": 3,
	"tickIntervalSeconds": 30,
	"drainTimeoutSeconds": 300,
	"claimExpirySeconds": 900,
	"latestVersionCacheSeconds": 21600,
	"maxFixRuns": 3,
	"serviceLabel": "md.moo.hum",
	"maxCrashes": 5,
	"crashWindowSeconds": 600,
	"workerDownTicks": 3,
	"tokenWarnDays": 30,
	"ciSchedule": "*/15 * * * *",
	"ciTickCacheSeconds": 300,
	"commitIdentity": {
		"name": "hum",
		"email": "hum@moo.md"
	},
	"itemsDir": ".hum/work",
	"providerTimeoutSeconds": 30,
	"providerBackoff": {
		"firstSeconds": 0.5,
		"maxSeconds": 30
	},
	"mergedShown": 50,
	"statusReadTimeoutSeconds": 10,
	"mergeTries": 3,
	"writeRaceRetries": 7,
	"itemReadsAtOnce": 8,
	"restartBackoff": {
		"firstSeconds": 1,
		"maxSeconds": 60
	},
	"restartDelaySeconds": 10,
	"ciWakeTimeoutMinutes": 60
}
