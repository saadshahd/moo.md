#!/bin/sh
set -e

# Targets come from the sync script itself, which discovers every SKILL.md under a plugin that
# has a _fragments/ dir. A hand-copied list silently stops guarding what it omits.
TARGETS=$(node scripts/sync.js --list)

before=$(git diff -- $TARGETS)
bun run sync
after=$(git diff -- $TARGETS)

if [ "$before" != "$after" ]; then
  echo "fragment drifted — commit the sync result"
  exit 1
fi
