#!/bin/sh
set -e

# Derived from package.json's sync --files list, so a new doc-gen consumer is covered the
# moment it is added there. A hand-copied list silently stops guarding what it omits.
TARGETS=$(node -e 'process.stdout.write(require("./package.json").scripts.sync.split("--files")[1].split("--open")[0].trim())')

before=$(git diff -- $TARGETS)
bun run sync
after=$(git diff -- $TARGETS)

if [ "$before" != "$after" ]; then
  echo "card spec drifted — commit the sync result"
  exit 1
fi
