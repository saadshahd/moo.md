---
// A move page's strip, in its title's place: the move, lit, and what it
// does. Chain pages name their moves on the demo's timeline instead.
import { stripMoves } from "../moves";

const { entry } = Astro.locals.starlightRoute;
const [name] = stripMoves(entry);
---

<p class="strip"><span class="chip">/{name}</span><span class="line">{entry.data.move}</span></p>

<style>
  /* One row of fixed height that scrolls rather than wraps: the move ink and
     paper swapped, then its line. */
  .strip {
    display: flex; align-items: center; height: 2rem; margin: 0;
    overflow-x: auto; overflow-y: hidden; white-space: nowrap; scrollbar-width: none;
  }
  .chip {
    flex: none; font: 400 0.9375rem / 1 var(--__sl-font-mono); border-radius: var(--moo-pill);
    padding: 0.4rem 0.6rem; background: var(--moo-ink); color: var(--moo-paper);
  }
  .line { margin-inline-start: 0.5rem; color: var(--moo-ink); font-size: 0.9375rem; }
  @media (max-width: 40rem) {
    .chip { font-size: 0.8125rem; padding: 0.35rem 0.45rem; }
  }
</style>
