---
/* The front band's fork: the job of the skills demo sessions, played through
   each question the moo-on session asked that had two answers, each with a
   preview. moo off shows the reply the moo-off session gave without asking.
   The panels are drawn here, so their buttons work from the first paint;
   band/fork.ts draws the line and plays the loop. */
import { turns as offTurns } from "../demo/sessions/skills-off";
import { turns as onTurns } from "../demo/sessions/skills-on";
import "../styles/fork.css";

const fail = (why: string): never => {
  throw new Error(`BandFork: ${why}`);
};
const job = onTurns[0].user.replace(/^\/\S+\s+/, "").replace(/\s+\/\S+/g, "");
const sentences = (s: string) => s.match(/.*?[.!?](?=\s+[A-Z]|$)/g) ?? [s];
/* The last two lines of a preview's last block, less their shared indent. */
const glimpse = (preview: string) => {
  const lines = preview.split("\n\n").at(-1)!.split("\n").slice(-2);
  const indent = Math.min(...lines.map((l) => l.match(/^ */)![0].length));
  return lines.map((l) => l.slice(indent)).join("\n");
};
const forks = onTurns
  .flatMap((t) => t.dialogs ?? [])
  .flatMap((d) => d.questions)
  .filter((q) => q.options.length === 2 && q.options.every((o) => o.preview))
  .map((q) => ({
    header: q.header,
    question: q.question,
    proposed: q.options.findIndex((o) => o.label.includes("(Recommended)")),
    options: q.options.map((o) => ({ label: o.label, preview: glimpse(o.preview!), result: sentences(o.description)[0].trim() })),
  }));
if (!forks.length) fail("the moo-on session asks no question with two answers, each with a preview");
const unproposed = forks.find((f) => f.proposed < 0);
if (unproposed) fail(`its question "${unproposed.header}" recommends neither answer`);
const alone = sentences(String(offTurns.at(-1)!.reply![0]))
  .slice(0, 2)
  .join("");
---

<div class="fork" data-fork data-phase="idle">
  <div class="fork-top" aria-hidden="true">
    <span class="fork-labels"><span class="fork-label off">moo off</span><span class="fork-label on">moo on</span></span>
    <span class="fork-job">{job}</span>
  </div>
  <div class="fork-path" data-path aria-hidden="true"></div>
  <div class="fork-panels">
    <div class="fork-panel" data-panel="off" aria-hidden="true"><p class="fork-alone">{alone}</p></div>
    {
      forks.map((f, k) => (
        <div class="fork-panel" data-panel={k} data-proposed={f.proposed} role="group" aria-labelledby={`fork-q${k}`} inert>
          <div class="fork-say">
            <p class="fork-q" id={`fork-q${k}`}>
              <span class="fork-head">{f.header}</span> {f.question}
            </p>
            {f.options.map((o, i) => (
              <p class="fork-result" data-result={i} aria-hidden="true">
                {o.result}
              </p>
            ))}
          </div>
          <div class="fork-opts">
            {f.options.map((o, i) => (
              <button type="button" class="fork-opt" data-opt={i} aria-pressed="false" aria-labelledby={`fork-n${k}-${i}`} aria-describedby={`fork-p${k}-${i}`}>
                <span class="fork-tags" aria-hidden="true">
                  <span class="tag taken">picked</span>
                  <span class="tag not">not taken</span>
                </span>
                <span class="fork-name" id={`fork-n${k}-${i}`}>{o.label}</span>
                <code class="fork-preview" id={`fork-p${k}-${i}`}>{o.preview}</code>
              </button>
            ))}
          </div>
        </div>
      ))
    }
    <div class="fork-panel" data-panel="end" tabindex="-1" inert>
      <ul class="fork-taken">
        {
          forks.map((f, k) => (
            <li data-row={k}>
              <span class="fork-head">{f.header}</span>
              {f.options.map((o, i) => (
                <span class="fork-took" data-took={i}>
                  {o.label}
                </span>
              ))}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <span class="fork-live" data-live aria-live="polite"></span>
</div>

<script>
  import { mount } from "../band/fork";
  const fork = document.querySelector<HTMLElement>("[data-fork]");
  if (fork) mount(fork);
</script>
