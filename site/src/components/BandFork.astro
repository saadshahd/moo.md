---
/* The front band's fork: the job of the skills demo sessions, played through
   each question the moo-on session asked that had two answers, each with a
   preview. moo off shows the reply the moo-off session gave without asking.
   The panels are drawn here, so their buttons work from the first paint;
   band/fork.ts draws the line and plays the loop. */
import { alone, forks, job } from "../band/job";
import "../styles/fork.css";
---

<div class="fork" data-fork data-phase="idle">
  <div class="band-top" aria-hidden="true">
    <span class="band-labels"><span class="band-label off">moo off</span><span class="band-label on">moo on</span></span>
    <span class="band-job">{job}</span>
  </div>
  <div class="fork-path" data-path aria-hidden="true"></div>
  <div class="fork-panels">
    <div class="fork-panel" data-panel="off" aria-hidden="true"><p class="fork-alone">{alone}</p></div>
    {
      forks.map((f, k) => (
        <div class="fork-panel" data-panel={k} data-proposed={f.proposed} role="group" aria-labelledby={`fork-q${k}`} inert>
          <div class="fork-say">
            <p class="fork-q" id={`fork-q${k}`}>
              <span class="band-head">{f.header}</span> {f.question}
            </p>
            {f.options.map((o, i) => (
              <p class="fork-result" data-result={i} aria-hidden="true">
                {o.result}
              </p>
            ))}
          </div>
          <div class="fork-opts">
            {f.options.map((o, i) => (
              <button type="button" class="fork-opt" data-opt={i} aria-pressed="false" aria-labelledby={`fork-n${k}-${i}`} aria-describedby={`fork-p${k}-${i}`}>
                <span class="fork-tags" aria-hidden="true">
                  <span class="tag taken">picked</span>
                  <span class="tag not">not taken</span>
                </span>
                <span class="fork-name" id={`fork-n${k}-${i}`}>{o.label}</span>
                <code class="fork-preview" id={`fork-p${k}-${i}`}>{o.preview}</code>
              </button>
            ))}
          </div>
        </div>
      ))
    }
    <div class="fork-panel" data-panel="end" tabindex="-1" inert>
      <ul class="fork-taken">
        {
          forks.map((f, k) => (
            <li data-row={k}>
              <span class="band-head">{f.header}</span>
              {f.options.map((o, i) => (
                <span class="fork-took" data-took={i}>
                  {o.label}
                </span>
              ))}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <span class="fork-live" data-live aria-live="polite"></span>
</div>

<script>
  import { mount } from "../band/fork";
  const fork = document.querySelector<HTMLElement>("[data-fork]");
  if (fork) mount(fork);
</script>
