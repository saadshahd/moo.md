---
/* One part of moo.md as a card that opens the part's page (parts/<part>.mdx).
   Its heading is the page's title and move line; the slot says what the part
   does. The whole card takes the click. */
import { getEntry } from "astro:content";
import { href } from "../link";

type Props = { part: string };
const { part } = Astro.props;
const page = await getEntry("docs", `parts/${part}`);
if (!page) throw new Error(`PartCard: no page at parts/${part}`);
---

<article class="part">
  <h2><a href={href(page.id)}>{page.data.title}: {page.data.move}.</a></h2>
  <slot />
</article>

<style>
  .part { position: relative; }
  a { color: inherit; text-decoration: none; }
  a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .part:hover a { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 0.08em; }
  a:focus-visible { outline: none; }
  a:focus-visible::after { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
