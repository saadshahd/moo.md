---
// Every page, one list per menu group side by side (menus.ts), for a page that
// has lost its reader: the 404.
import MenuItems from "./MenuItems.astro";
import { siteMenus } from "../menus";

const menus = await siteMenus();
---

<div class="ways not-content">
  {menus.map((m) => (
    <section>
      <h2>{m.label}</h2>
      <MenuItems items={m.items} here={Astro.url.pathname} kind={m.look} />
    </section>
  ))}
</div>
