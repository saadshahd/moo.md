---
// On a demo page, the front page among them, the title is for the tab and
// screen readers alone, so the terminal comes first. Every other page shows
// its title and, under it, its description in plain words.
const { entry } = Astro.locals.starlightRoute;
const { title, moves, move, template } = entry.data;
const demo = (moves !== undefined || move !== undefined) && template !== "splash";
---

{
  demo ? (
    <h1 id="_top" class="vh">{title}</h1>
  ) : (
    <>
      <h1 id="_top">{title}</h1>
      {entry.data.description && <p class="lede">{entry.data.description}</p>}
    </>
  )
}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .vh {
    position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
</style>
