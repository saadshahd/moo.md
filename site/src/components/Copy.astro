---
// One command and a button that copies it.
type Props = { command: string };
const { command } = Astro.props;
---

<div class="copy not-content">
  <code>{command}</code>
  <button type="button" data-copy={command}>Copy</button>
  <span class="vh" aria-live="polite" data-live></span>
</div>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const flash = (label: string) => {
      b.textContent = label;
      setTimeout(() => (b.textContent = "Copy"), 1400);
    };
    b.addEventListener("click", async () => {
      const text = b.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
        flash("Copied");
        b.parentElement!.querySelector("[data-live]")!.textContent = `Copied ${text}`;
      } catch {
        // Clipboard blocked: select the command so ⌘C still works.
        getSelection()!.selectAllChildren(b.parentElement!.querySelector("code")!);
        flash("Press ⌘C");
      }
    });
  }
</script>

<style>
  /* A command on a surface one tone off the page, its Copy button a pill. */
  .copy {
    display: flex; align-items: center; gap: 0.75rem; max-width: 100%;
    margin-top: 0.75rem; padding: 0.5rem 0.5rem 0.5rem 1rem;
    background: var(--moo-surface); border-radius: var(--moo-radius);
  }
  code {
    flex: 1; font-family: var(--__sl-font-mono); font-size: 0.8125rem; line-height: 1.5;
    color: var(--sl-color-white); background: none; padding: 0; overflow-wrap: anywhere;
  }
  button {
    flex: none; border: 0; background: var(--moo-band); color: var(--sl-color-white);
    border-radius: var(--moo-pill); height: 2.25rem; padding: 0 1rem; font: 600 var(--sl-text-sm) / 1 var(--__sl-font); cursor: pointer;
    transition: background-color 120ms ease-out;
  }
  button:hover { background: var(--sl-color-gray-5); }
  button:active { transform: translateY(1px); }
  button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  @media (max-width: 40rem) {
    .copy { margin-top: 0.5rem; padding-block: 0.375rem; }
  }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
