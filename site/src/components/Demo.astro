---
// A Claude Code mock built from a real recorded pair: the same words typed with
// moo off and with moo on, two terminals side by side, each with the same
// glyphs, colors, wrap rule, spinner verbs and replies as recorded, cut only
// where "… +N lines" says so. Plays once in view: moo off first, then moo on,
// with a player's controls below: play and pause, a timeline in two parts
// with a tick at each wait, speed. Where the two don't fit side by side, one
// frame shows the pane playing, under tabs that name both. Under reduced
// motion, the timeline steps through one still per wait. `summary` tells a
// screen reader what it shows. Both panes draw at the widest of COLS whose
// pair fits the page, as many rows tall as the screen's height leaves them,
// PANE.rows at least; the clock runs on PANE at every size.
import type { Pair, Scene } from "../demo/types";
import { COLS, frame, PANE, phases, ROWS, waits } from "../demo/render";
import { demoMoves } from "../moves";
import { SPEEDS } from "../demo/speed";
// The terminal font: Fira Code, as in the Solo terminal the demos are checked
// against. Its glyphs for box drawing come from the symbols subset.
import "@fontsource/fira-code/latin-400.css";
import "@fontsource/fira-code/latin-700.css";
import "@fontsource/fira-code/symbols2-400.css";

type Props = { scene: Pair; summary: string };
const { scene: pair, summary } = Astro.props;
const { entry } = Astro.locals.starlightRoute;
const names = demoMoves(entry);
const fail = (why: string): never => {
  throw new Error(`${entry.id}: ${why}`);
};

// moo off types words, not a command, and tend draws nothing there: moo's
// plugins were off. moo on runs the page's first move with its first prompt,
// and every move the page names, by a prompt or a Skill call.
const last = (skill: string) => skill.split(":").pop();
const { off, on } = pair;
if (off.turns.some((t) => t.user.startsWith("/")))
  fail(`its moo-off pane types a command: ${off.turns.find((t) => t.user.startsWith("/"))!.user}`);
if (off.turns.some((t) => t.toast || t.panes || t.chrome.some(([, c]) => c.band?.length)))
  fail("its moo-off pane draws tend's band, toast or card");
if (last(on.turns[0]?.user.match(/^\/(\S+)/)?.[1] ?? "") !== names[0])
  fail(`its moo-on pane's first prompt must run /${names[0]}`);
const launched = new Set(
  on.turns.flatMap((t) => [t.user.match(/^\/(\S+)/)?.[1], ...(t.launches ?? []).map((l) => l.skill)].filter(Boolean).map((x) => last(x!))),
);
const missed = names.filter((n) => !launched.has(n));
if (missed.length) fail(`its moo-on pane never runs ${missed.map((n) => `/${n}`).join(", ")}`);
// Draw each pane here at each second and each wait, at each count the
// player can pick, at the fewest rows it draws and at twice the recorded
// terminal's (taller than a 1440px screen gives), so a scene the player
// cannot draw fails the build, not the page.
const drawn = (scene: Scene) => {
  if (!scene.turns.length) return;
  const { length } = phases(scene);
  for (const s of [...Array.from({ length: Math.ceil(length) }, (_, k) => k), ...waits(scene).map((w) => w.at), length])
    for (const cols of COLS) for (const rows of [PANE.rows, 2 * ROWS]) frame(scene, s, cols, undefined, rows);
};
drawn(off);
drawn(on);
const sides = [
  ["off", "moo off"],
  ["on", "moo on"],
] as const;
---

<div class="demo not-content" style={`--rows: ${PANE.rows}`} data-demo={JSON.stringify(pair)}>
  <div class="col">
    <figure class="term-wrap">
      <figcaption class="vh">{summary}</figcaption>
      <div class="tabs" role="group" aria-label="Panes">
        {sides.map(([side, label]) => (
          <button type="button" data-tab={side} aria-pressed={String(side === "off")}>{label}</button>
        ))}
      </div>
      <div class="pair" data-pair>
        {sides.map(([side, label]) => (
          <div class="side" data-side={side}>
            <div class="term" data-term>
              <span class="label" aria-hidden="true">{label}</span>
              <div class="caret-trail" data-trail aria-hidden="true"></div>
              <div class="scroll" data-scroll tabindex="0" role="region" aria-label={`Claude Code, ${label}`}></div>
              <div class="bottom" data-bottom tabindex="-1"></div>
              <div class="toast" data-toast aria-hidden="true"></div>
              <div class="caret" data-caret aria-hidden="true"></div>
              <div class="keys" data-keys aria-hidden="true"></div>
            </div>
          </div>
        ))}
        <div class="flash" data-flash aria-hidden="true"></div>
      </div>
      <div class="controls">
        <button type="button" class="play" data-play aria-label="Pause demo">❚❚</button>
        <span class="now" aria-hidden="true" data-now>0:00</span>
        <div class="track" data-track role="slider" tabindex="0" aria-label="Demo timeline">
          <div class="rail" data-rail><div class="fill" data-fill></div></div>
          <div class="knob" data-knob aria-hidden="true"></div>
        </div>
        <span class="total" data-total aria-hidden="true"></span>
        <div class="speed" role="group" aria-label="Speed">
          {SPEEDS.map((x) => <button type="button" data-speed={x} aria-pressed={String(x === 1)}>{x}×</button>)}
        </div>
      </div>
    </figure>
    <div class="probe" data-probe aria-hidden="true"><span>0000000000</span></div>
  </div>
</div>

<script>
  import { mount } from "../demo/player";
  for (const root of document.querySelectorAll<HTMLElement>("[data-demo]")) mount(root);
</script>

<style>
  /* Styles reach rows the player builds; hence :global. */
  .demo { --muted: var(--sl-color-gray-3); --accent: var(--sl-color-accent); container: demo / inline-size; }
  /* The pair takes the page's whole width, its gutters the content's: past
     the content column, which stops at 1400px. The content panel is the
     container 100cqi measures (the global styles below). */
  .demo { width: 100cqi; margin-inline: calc((100% - 100cqi) / 2); }
  .col { position: relative; width: fit-content; max-width: 100%; }
  /* A pane: its cells, the padding at its left, the room at its right for
     the scroll's padding and a thin scrollbar, its border: 356px at 45
     columns of 7px cells, 601px at 80, 881px at 120. Each is the container
     its full-width rows reach across. */
  .demo { --pad: 16px; }
  .col { --pane-w: calc(var(--cols) * var(--cell) + var(--cell) + 2 * var(--pad) + 2px); }
  /* Both panes draw at the widest of render.ts COLS whose pair, two panes
     and the gap between, fits: 1778px at 120 columns, 1218px at 80, else
     45. The player reads --cols from here. */
  .col { --cols: 45; }
  @container demo (min-width: 1218px) { .col { --cols: 80; } }
  @container demo (min-width: 1778px) { .col { --cols: 120; } }
  .pair { position: relative; display: flex; gap: var(--pad); }
  .side { container-type: inline-size; width: var(--pane-w); max-width: 100%; }
  /* Each pane's name sits in its top border, as a frame's title. */
  .label {
    position: absolute; top: calc(-0.5 * var(--row)); left: calc(var(--inset) + var(--cell)); z-index: 3;
    padding: 0 var(--cell); background: var(--t-bg); color: var(--t-g); line-height: var(--row);
  }
  /* Where two 45-column panes don't fit side by side (728px), one frame
     shows the pane playing, at 45, and tabs above it name both, in place of
     the labels. */
  .tabs { display: none; gap: 2px; margin-bottom: var(--moo-step, 0.5rem); }
  @container demo (max-width: 727px) {
    /* The tabs' 1.75rem (chrome.css) and the step under them, which the
       pane gives up. */
    .col { --tabs-h: calc(1.75rem + var(--moo-step)); }
    .tabs { display: flex; }
    .label { display: none; }
    .demo[data-shown="off"] .side[data-side="on"], .demo[data-shown="on"] .side[data-side="off"] { display: none; }
  }
  .vh {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }

  /* The player's controls under the terminal: play, the time so far, the
     timeline with its knob, the length, and the speed group. Their look is the
     site chrome's (chrome.css); these rules only lay them out. */
  .controls { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.5rem; width: 0; min-width: 100%; }
  .controls button {
    flex: none; border: 0; background: none; color: var(--muted); cursor: pointer;
    font: inherit; font-size: var(--sl-text-xs); min-width: 1.8rem; height: 1.8rem; border-radius: 0.4rem;
  }
  .controls button:hover { color: var(--sl-color-white); }
  .demo :global(button:focus-visible), .track:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .now, .total { flex: none; font-size: var(--sl-text-xs); font-variant-numeric: tabular-nums; color: var(--muted); }
  @container demo (max-width: 603px) { .now, .total { display: none; } }
  .speed { flex: none; display: flex; font-variant-numeric: tabular-nums; }
  .speed button[aria-pressed="true"] { color: var(--sl-color-white); }
  .knob { position: absolute; top: 50%; left: 0; width: 12px; height: 12px; margin: -6px; border-radius: 50%; background: var(--muted); pointer-events: none; z-index: 1; }
  .track { position: relative; flex: 1; height: 1.8rem; cursor: pointer; touch-action: none; border-radius: 0.3rem; }
  .rail { position: absolute; left: 0; right: 0; top: 50%; height: 4px; margin-top: -2px; border-radius: 2px; background: var(--sl-color-gray-5); overflow: hidden; }
  .fill { height: 100%; clip-path: inset(0 100% 0 0); background: var(--muted); }
  /* A tick per beat: a dot on the rail. The timeline is the target; a press
     near a tick goes to its beat (player.ts). */
  .demo :global(.tick) {
    position: absolute; top: 50%; width: 8px; height: 8px; margin: -4px; pointer-events: none;
    border-radius: 50%; background: var(--sl-color-white); box-shadow: 0 0 0 2px var(--sl-color-black);
  }
  .demo.reduced .play, .demo.reduced .speed, .demo.reduced .now, .demo.reduced .total { visibility: hidden; }

  /* The terminal's colours, dark on the light page: as recorded from Claude
     Code 2.1.316, its ANSI colours Solo's (One Dark). */
  .demo {
    --t-bg: #141414; --t-fg: #e6e6e6; --t-border: #2c2c2c; --t-scroll: #3a3a3a; --t-user: #373737;
    --t-o: #d77757; --t-o2: #eb9f7f; --t-g: #999999; --t-g2: #adadad; --t-l: #b1b9f9; --t-tab-fg: #000000;
    --t-w: #ffffff; --t-r: #888888; --t-add: #38a660; --t-del: #b3596b; --t-ok: #4eba65; --t-amb: #ffc107;
    --t-cursor: #e6e6e6; --t-logo: #d77757; --t-eye: #000000; --t-sub: #505050;
    --t-c31: #f07178; --t-c32: #98c379; --t-c34: #7aa2f7; --t-c37: #abb2bf; --t-c95: #d5bfff; --t-c96: #7fdbca;
    --t-key-bg: #2a2a2aee; --t-key-border: #444444; --t-key-fg: #e6e6e6; --t-flash-bg: #000000aa; --t-flash-fg: #ffffff;
  }
  /* The terminal: colors as recorded from Claude Code 2.1.316; type as the
     user's Solo terminal draws it (terminalFontScale 0.923 of its 13px base,
     terminalLineHeight 1.7, terminalLetterSpacing 0.95), as measured on a
     screen shot of Solo at 80 columns on a 2x display: a cell is Fira Code
     6's advance (1200/1950 em) times 0.95, 14 device pixels; a row is 1.7
     times 12px rounded up, 41; a box line is one device pixel. Fontsource's
     Fira Code advances 0.6em, so letter-spacing makes up the rest. --cell
     and --row size everything a terminal sizes in cells. */
  .term-wrap { margin: 0; }
  /* 13px × 0.923 is 11.999px; 12px reads the same and clears Lighthouse's
     12px floor for legible text. */
  .demo { --fs: 12px; --row: 20.5px; --cell: 7px; --line: 1px; }
  @media (min-resolution: 2dppx) { .demo { --line: 0.5px; } }
  .demo :global(.term), .probe {
    font-family: "Fira Code", Menlo, "SF Mono", ui-monospace, monospace;
    font-size: var(--fs);
    line-height: var(--row);
    letter-spacing: calc(var(--cell) - 0.6em);
    font-variant-ligatures: none;
  }
  .demo :global(.term) {
    display: flex; flex-direction: column; box-sizing: border-box;
    /* The demo's height (chrome.css) less the tabs, if any; --rows rows of
       text inside the padding and border at least. The player draws the
       whole rows it holds; part of a row left over shows the transcript. */
    height: max(calc(var(--rows) * var(--row) + 2 * var(--pad) + 2px), var(--moo-demo-h) - var(--tabs-h, 0px));
    width: 100%;
    /* One inner padding, --pad, above, below and at the left, where the grid
       sits, or centred where the frame leaves less; the scroll's own right
       padding and its scrollbar sit in the room on the right, and the
       full-width rows end --inset from the right edge. 100cqi is the
       frame's width. */
    --inset: max(4px, min(var(--pad), calc((100cqi - var(--cols) * var(--cell) - 2px) / 2)));
    padding: var(--pad) 0 var(--pad) var(--inset); border: 1px solid var(--t-border); border-radius: 0.6rem;
    background: var(--t-bg); color: var(--t-fg);
  }
  /* Padding on the right: an overlay scrollbar covers it, not the last column. */
  .demo :global(.scroll) {
    position: relative; z-index: 1; flex: 1; min-height: 0; padding-right: var(--cell); overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; overflow-anchor: none;
    scrollbar-width: thin; scrollbar-color: var(--t-scroll) transparent; scrollbar-gutter: stable;
  }
  .demo :global(.scroll:focus-visible) { outline: 1px solid var(--accent); outline-offset: 2px; }
  /* A fade at the top says there is more above to scroll back to. */
  .scroll.above { mask-image: linear-gradient(to bottom, transparent 0, #000 calc(2 * var(--row))); }
  .bottom { flex: none; position: relative; z-index: 1; }
  .bottom:focus { outline: none; }
  /* A toast slides in over the top right corner of the terminal's text, from
     its right edge, as hunch's did. */
  .demo :global(.term) { position: relative; }
  .toast {
    position: absolute; top: var(--pad); left: var(--inset); width: calc(var(--cols) * var(--cell));
    overflow: hidden; pointer-events: none;
  }
  .toast :global(.box) { width: fit-content; margin-left: auto; background: var(--t-bg); }
  .toast :global(.box .row) { width: auto; }
  /* Measures one column, for the caret. */
  .probe { position: absolute; top: 0; left: 0; visibility: hidden; white-space: pre; }
  .demo :global(.row) { width: calc(var(--cols) * var(--cell)); height: var(--row); white-space: pre; overflow: hidden; }
  /* A glyph Fira Code lacks comes from another font, with its own width; a
     terminal keeps it in one cell. */
  .demo :global(.gl) { display: inline-block; width: var(--cell); letter-spacing: 0; text-align: center; overflow: visible; }
  /* Box drawing as a terminal draws it: each arm reaches the cell's edge, so
     lines join across rows at any line height. The glyph stays, unseen, for
     copying. Arms: u(p), d(own), l(eft), r(ight); a: a rounded corner. */
  .demo :global(.bx) { display: inline-block; position: relative; height: var(--row); vertical-align: top; }
  .demo :global(.bx > i) { font-style: normal; opacity: 0; }
  .demo :global(.bx::before), .demo :global(.bx::after) { content: ""; position: absolute; border: 0 solid; }
  .demo :global(.bx::before) { left: calc(50% - var(--line) / 2); border-left-width: var(--line); top: calc(50% - var(--line) / 2); bottom: calc(50% - var(--line) / 2); }
  .demo :global(.bx.u::before) { top: 0; }
  .demo :global(.bx.d::before) { bottom: 0; }
  .demo :global(.bx::after) { top: calc(50% - var(--line) / 2); border-top-width: var(--line); left: calc(50% - var(--line) / 2); right: calc(50% - var(--line) / 2); }
  .demo :global(.bx.l::after) { left: 0; }
  .demo :global(.bx.r::after) { right: 0; }
  .demo :global(.bx.a::before) { display: none; }
  .demo :global(.bx.a::after) { border-left-width: var(--line); }
  .demo :global(.bx.a.d::after) { bottom: 0; }
  .demo :global(.bx.a.u::after) { top: 0; bottom: calc(50% - var(--line) / 2); border-top-width: 0; border-bottom-width: var(--line); }
  .demo :global(.bx.a.l::after) { border-left-width: 0; border-right-width: var(--line); }
  .demo :global(.bx.a.d.r::after) { border-top-left-radius: calc(var(--cell) * 0.6); }
  .demo :global(.bx.a.d.l::after) { border-top-right-radius: calc(var(--cell) * 0.6); }
  .demo :global(.bx.a.u.r::after) { border-bottom-left-radius: calc(var(--cell) * 0.6); }
  .demo :global(.bx.a.u.l::after) { border-bottom-right-radius: calc(var(--cell) * 0.6); }
  .demo :global(.row.user) { background: var(--t-user); box-shadow: 0 1px 0 var(--t-user); }
  /* Claude Code's full-width rows reach the frame's right edge, the left
     inset away from it, as the user asked: the user turn's bar, the prompt
     box's rules, the status line, whose output style ends there. Their text
     still wraps at --cols. */
  .demo :global(.row.user), .demo :global(.row.wide) {
    width: min(100%, max(var(--cols) * var(--cell), 100cqi - 2px - 2 * var(--inset)));
  }
  .demo :global(.row.wide) { display: flex; }
  .demo :global(.row.wide .fill), .demo :global(.row.rule > span) { flex: 1; display: flex; }
  .demo :global(.row.rule .bx) { flex: 1; }
  /* The logo in whole pixels, centered in its row. A quadrant of a terminal
     cell is twice as tall as it is wide, so each is --px wide and 2 --px tall. */
  .demo :global(svg.logo .eye) { fill: var(--t-eye); }
  .demo :global(svg.logo .body) { fill: var(--t-logo); }
  .demo :global(svg.logo) {
    --px: 2px;
    display: inline-block; vertical-align: top;
    width: calc(var(--w) * var(--px)); height: calc(var(--h) * 2 * var(--px));
    margin-top: calc((var(--row) - var(--h) * 2 * var(--px)) / 2);
  }
  .demo :global(.o) { color: var(--t-o); }
  .demo :global(.b) { font-weight: bold; }
  .demo :global(.i) { font-style: italic; }
  .demo :global(.g) { color: var(--t-g); }
  .demo :global(.l) { color: var(--t-l); }
  .demo :global(.w) { color: var(--t-w); }
  .demo :global(.r) { color: var(--t-r); }
  .demo :global(.add) { color: var(--t-add); }
  .demo :global(.del) { color: var(--t-del); }
  .demo :global(.cursor) { background: var(--t-cursor); }
  .demo :global(.tab) { background: var(--t-l); color: var(--t-tab-fg); }
  .demo :global(.ok) { color: var(--t-ok); }
  .demo :global(.d) { opacity: 0.5; }
  .demo :global(.amb) { color: var(--t-amb); }
  .demo :global(.o2) { color: var(--t-o2); }
  .demo :global(.g2) { color: var(--t-g2); }
  /* ANSI colors in the Solo palette the demos are checked against. */
  .demo :global(.c31) { color: var(--t-c31); }
  .demo :global(.c32) { color: var(--t-c32); }
  .demo :global(.c34) { color: var(--t-c34); }
  .demo :global(.c37) { color: var(--t-c37); }
  .demo :global(.c95) { color: var(--t-c95); }
  .demo :global(.c96) { color: var(--t-c96); }
  /* Half a row under each option's description, as the user asked (fit() in
     render.ts counts it). */
  .demo :global(.row.gap) { margin-bottom: calc(var(--row) / 2); }
  /* Half a row under the banner, as the user asked, so the first prompt reads
     apart from it. It scrolls with the transcript; the terminal keeps its height. */
  .demo :global(.row.banner) { margin-bottom: calc(var(--row) / 2); }
  .demo :global([data-opt]) { cursor: pointer; }
  /* tend's buttons: its chips and the pane's close, as text in the grid. Its
     brackets in the subtle grey recorded; hover marks what takes a click in
     the selection colour, as tend's band does. */
  .demo :global(.sub) { color: var(--t-sub); }
  .demo :global(button.act) {
    all: unset; cursor: pointer; white-space: pre;
  }
  .demo :global(button.act:hover) { color: var(--t-l); }
  .demo :global(button.act:focus-visible) { outline: 1px solid var(--accent); outline-offset: 1px; }

  /* The cursor: a block that inverts the text under it, gliding between cells
     at the playback speed (--glide, player.ts), blinking softly at rest; plain
     under reduced motion. A move leaves a short smear behind the text: flat,
     a soft hue that changes with each move, fading in --decay into the
     cursor's own colour as it shows (--t-cursor). */
  .caret, .caret-trail { position: absolute; left: 0; top: 0; pointer-events: none; }
  .caret {
    width: var(--cell); height: var(--row); background: #e6e6e6; mix-blend-mode: difference;
    transition: transform var(--glide, 90ms) cubic-bezier(0.22, 1, 0.36, 1); z-index: 2;
  }
  .caret:global(.rest) { animation: blink 1.2s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: 0.35; } }
  .caret-trail {
    background: var(--t-cursor); opacity: 0; border-radius: 2px; z-index: 0;
    transition: opacity var(--decay, 280ms) cubic-bezier(0.22, 1, 0.36, 1), background-color var(--decay, 280ms) ease;
  }
  .caret-trail:global(.hot) { background: oklch(0.78 0.09 var(--hue, 0)); opacity: 0.4; }
  @media (prefers-reduced-motion: reduce) {
    .caret { transition: none; }
    .caret:global(.rest) { animation: none; }
    .caret-trail { display: none; }
  }

  /* A click on the terminal plays or pauses it, as on a video: the new state's
     glyph shows in the centre, then fades. */
  .demo :global(.term) { cursor: pointer; }
  .demo :global(.term [data-opt]) { cursor: pointer; }
  .flash {
    position: absolute; left: 50%; top: 50%; width: 3.5rem; height: 3.5rem; margin: -1.75rem 0 0 -1.75rem;
    display: grid; place-items: center; border-radius: 50%; background: var(--t-flash-bg); color: var(--t-flash-fg);
    font: 1.3rem / 1 var(--sl-font); pointer-events: none; opacity: 0; z-index: 4;
  }
  .flash:global(.on) { animation: flash 600ms ease-out forwards; }
  @keyframes flash { 0% { opacity: 1; transform: scale(0.9); } 100% { opacity: 0; transform: scale(1.15); } }

  /* Keys the recorder pressed, as keycaps centred just above the prompt box
     or the dialog (player.ts placeKeys()), so they cover none of its text. */
  .keys {
    position: absolute; left: 50%; top: 0; transform: translateX(-50%); display: flex; gap: 0.3rem;
    max-width: calc(100% - 1.4rem); justify-content: center;
    pointer-events: none; font-family: var(--sl-font); z-index: 3;
  }
  .keys :global(kbd) {
    font: 600 var(--sl-text-xs) / 1 var(--sl-font); color: var(--t-key-fg); background: var(--t-key-bg);
    border: 1px solid var(--t-key-border); border-bottom-width: 2px; border-radius: 0.35rem; padding: 0.3rem 0.45rem;
    flex: none; white-space: nowrap;
  }

  /* Between demo pages, the terminals and the controls stay put while what
     they show changes (the view transition in the global styles). */
  [data-side="off"] .term { view-transition-name: demo-off; }
  [data-side="on"] .term { view-transition-name: demo-on; }
  .controls { view-transition-name: demo-controls; }
</style>

<style is:global>
  :root:has(.demo) main { padding-bottom: 0; }
  /* What the pair measures its width against: the content panel, the
     page's width less its gutters. */
  :root:has(.demo) .content-panel { container-type: inline-size; }
  /* Going from one demo page to another, the browser swaps the pages in one
     transition, so the terminal never jumps. */
  @view-transition { navigation: auto; }
  @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
</style>
