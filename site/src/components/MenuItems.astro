---
// One menu's links (TopBar.astro). A chain shows its title and its one line;
// any other page its command and what it does. The page you are on is toned,
// with an ink bar: a state marker, so it never takes the accent. A menu with
// groups (the Moves) shows each group under its heading, three columns wide;
// `stack` fits as many columns as its width holds (the phone sheet, the 404).
// Tab order follows the groups either way. `at` names the place
// the menu shows, for the headings' ids.
type Item = { href: string; label: string; note?: string };
type Group = { heading: string; items: Item[] };
const { items, groups, here, kind, stack = false, at } = Astro.props as {
  items: Item[]; groups?: Group[]; here: string; kind: string; stack?: boolean; at: string;
};
// Group headings' ids: unique per place a menu shows on the page.
const id = `${at}-group`;
---

{groups ? (
  <div class:list={["groups", { stack }]}>
    {groups.map((g, k) => (
      <div class="group">
        <div class="heading" id={`${id}-${k}`}>{g.heading}</div>
        <ul class={kind} aria-labelledby={`${id}-${k}`}>
          {g.items.map((i) => (
            <li>
              <a href={i.href} aria-current={i.href === here ? "page" : undefined}>
                <span class="label">{i.label}</span>
                {i.note && <span class="note">{i.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
) : (
  <ul class:list={[kind, { stack }]}>
    {items.map((i) => (
      <li>
        <a href={i.href} aria-current={i.href === here ? "page" : undefined}>
          <span class="label">{i.label}</span>
          {i.note && <span class="note">{i.note}</span>}
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  a {
    position: relative; display: flex; flex-direction: column; gap: 0.2rem; padding: 0.7rem 0.75rem 0.7rem 1.4rem;
    border-radius: 0.5rem; color: var(--moo-ink); text-decoration: none; transition: background-color 120ms ease-out;
  }
  a:hover, a[aria-current="page"] { background: var(--moo-band); }
  a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: -2px; }
  /* The page you are on. */
  a[aria-current="page"]::before {
    content: ""; position: absolute; left: 0.6rem; top: 0.75rem; bottom: 0.75rem; width: 0.3rem; background: var(--moo-ink);
  }
  .label { font: 600 0.9375rem / 1.25 var(--__sl-font); }
  .note { font: 400 0.875rem / 1.35 var(--__sl-font); color: var(--sl-color-gray-3); }
  .commands a { flex-direction: row; align-items: baseline; gap: 1rem; }
  /* As wide as the longest command, /interrogate. */
  .commands .label { flex: none; width: 7rem; font: 400 0.9375rem / 1.25 var(--__sl-font-mono); }

  /* Groups: three columns, filled row by row, so the order reads and tabs
     group by group. A line stays on one row. */
  .groups { display: grid; grid-template-columns: repeat(3, max-content); align-items: start; gap: 0.75rem 0.5rem; }
  .heading {
    margin: 0.5rem 0.75rem 0.25rem 1.4rem; font: 500 0.75rem / 1.2 var(--__sl-font);
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--sl-color-gray-3);
  }
  .groups .note { white-space: nowrap; }
  .groups a { padding-block: 0.55rem; }
  /* Stacked: as many columns as fit one command, /interrogate, the longest. */
  .groups.stack { grid-template-columns: repeat(auto-fill, minmax(9.25rem, 1fr)); gap: 1rem 0.5rem; }
  /* On a screen too narrow for a command and its longest line side by side
     (432 px), each line goes under its command, so none wraps. */
  @media (max-width: 27rem) {
    :is(.stack .commands, .commands.stack) a { flex-direction: column; align-items: stretch; gap: 0.2rem; }
  }
</style>
